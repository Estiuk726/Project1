# Copy to .env and fill in. Never commit .env.
# Every variable is validated at server start (packages/config/src/env.ts);
# the server exits with an error naming anything missing or invalid.

# NODE_ENV is set by Next.js and the test runner; do not set it here.

# Postgres connection string.
# Local: postgres://postgres:postgres@localhost:5432/flightmates
# Supabase (ADR 0002): session pooler or direct URL for migrations,
# transaction pooler (port 6543) for the running app.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flightmates

# Supabase Auth (ADR 0003): Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only secret. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Error tracking (ADR 0004): Sentry, EU data region only (DSN host ends in .de.sentry.io).
# Leave empty to only log errors. Sentry > Project Settings > Client Keys (DSN).
SENTRY_DSN=
# Environment name shown in Sentry: local, staging or production.
SENTRY_ENVIRONMENT=local
